# =============================================================================
# PDV Sandubaria — configuração do launcher Linux
# =============================================================================
# Este arquivo é lido pelo launcher na máquina do estabelecimento.
# Não coloque senhas, tokens ou credenciais aqui.
# =============================================================================

# URL de produção da PWA na Vercel. O launcher abre esta página após o
# Print Agent responder em http://127.0.0.1:9100/health
PDV_URL=https://pdv-sandubaria.vercel.app

# Origem liberada no CORS do Print Agent. Deve ser a mesma origem da PWA.
# Para mais de um domínio, separe por vírgula.
PDV_ORIGIN=https://pdv-sandubaria.vercel.app

# Print Agent escuta somente em localhost.
HOST=127.0.0.1
PORT=9100

# Dispositivo da impressora térmica POS-58
PRINTER_DEVICE=/dev/usb/lp0
